// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  clerkId         String           @unique
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  codingSessions  CodingSession[]
  platformProfiles PlatformProfile[]
  unifiedMetricSnapshots UnifiedMetricSnapshot[]
  platformRatingHistory PlatformRatingHistory[]
  platformSolvedSnapshots PlatformSolvedSnapshot[]
  platformContestHistory PlatformContestHistory[]
  syncJobLogs      SyncJobLog[]
}

model CodingSession {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime
  platform          Platform
  problemsSolved    Int      @default(0)
  easy              Int      @default(0)
  medium            Int      @default(0)
  hard              Int      @default(0)
  timeSpentMinutes  Int      @default(0)
  topics            String[]
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([date])
}

model PlatformProfile {
  id            String    @id @default(cuid())
  userId        String
  platform      Platform
  handle        String
  profileUrl    String?
  syncStatus    SyncStatus @default(IDLE)
  lastSyncStartedAt DateTime?
  lastSyncedAt  DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  lastErrorCode String?
  rawSnapshot   Json?
  rawStatsJson  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratingHistory PlatformRatingHistory[]
  solvedSnapshots PlatformSolvedSnapshot[]
  contestHistory PlatformContestHistory[]
  syncJobLogs    SyncJobLog[]
  
  @@unique([userId, platform])
  @@index([userId])
}

model SyncJobLog {
  id                String     @id @default(cuid())
  userId            String
  platformProfileId String?
  platform          Platform?
  source            SyncSource @default(MANUAL)
  status            SyncStatus
  message           String?
  errorCode         String?
  startedAt         DateTime
  finishedAt        DateTime?
  durationMs        Int?
  createdAt         DateTime   @default(now())

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformProfile   PlatformProfile? @relation(fields: [platformProfileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PlatformRatingHistory {
  id                String    @id @default(cuid())
  userId            String
  platformProfileId String
  platform          Platform
  eventAt           DateTime
  rating            Int?
  rank              String?
  contestName       String?
  delta             Int?
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformProfile   PlatformProfile @relation(fields: [platformProfileId], references: [id], onDelete: Cascade)

  @@index([userId, platform, eventAt])
  @@unique([platformProfileId, eventAt, contestName])
}

model PlatformSolvedSnapshot {
  id                String    @id @default(cuid())
  userId            String
  platformProfileId String
  platform          Platform
  capturedAt        DateTime
  totalSolved       Int       @default(0)
  easySolved        Int?
  mediumSolved      Int?
  hardSolved        Int?
  byTag             Json?
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformProfile   PlatformProfile @relation(fields: [platformProfileId], references: [id], onDelete: Cascade)

  @@index([userId, platform, capturedAt])
  @@unique([platformProfileId, capturedAt])
}

model PlatformContestHistory {
  id                String    @id @default(cuid())
  userId            String
  platformProfileId String
  platform          Platform
  contestId         String?
  contestName       String
  contestDate       DateTime
  rank              Int?
  ratingBefore      Int?
  ratingAfter       Int?
  ratingDelta       Int?
  problemsSolved    Int?
  score             Float?
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformProfile   PlatformProfile @relation(fields: [platformProfileId], references: [id], onDelete: Cascade)

  @@index([userId, platform, contestDate])
  @@unique([platformProfileId, contestDate, contestName])
}

model UnifiedMetricSnapshot {
  id                    String    @id @default(cuid())
  userId                String
  capturedAt            DateTime
  totalSolved           Int       @default(0)
  easySolved            Int       @default(0)
  mediumSolved          Int       @default(0)
  hardSolved            Int       @default(0)
  strongestPlatform     Platform?
  averageRating         Float?
  platformBreakdown     Json?
  createdAt             DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@unique([userId, capturedAt])
}

enum Platform {
  LEETCODE
  CODEFORCES
  CODECHEF
  GEEKSFORGEEKS
  HACKERRANK
  ATCODER
  OTHER
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  ERROR
}

enum SyncSource {
  MANUAL
  SCHEDULED
}